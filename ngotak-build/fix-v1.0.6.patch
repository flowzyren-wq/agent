+// Orientasi player — anti-gagal:
+// 1) expo-screen-orientation (jalur resmi Expo, kompatibel New Arch RN 0.86)
+// 2) fallback react-native-orientation-locker (modul lama; pada sebagian
+//    kondisi bridgeless getCurrentActivity() null → no-op senyap, itulah
+//    penyebab player tidak otomatis landscape di build sebelumnya)
+const lockLandscape = async () => {
+  try {
+    await ExpoScreenOrientation.lockAsync(
+      ExpoScreenOrientation.OrientationLock.LANDSCAPE,
+    );
+    return;
+  } catch {}
+  try {
+    Orientation.lockToLandscape();
+  } catch {}
+};
+
+const lockPortrait = async () => {
+  try {
+    await ExpoScreenOrientation.lockAsync(
+      ExpoScreenOrientation.OrientationLock.PORTRAIT_UP,
+    );
+    return;
+  } catch {}
+  try {
+    Orientation.lockToPortrait();
+  } catch {}
+};

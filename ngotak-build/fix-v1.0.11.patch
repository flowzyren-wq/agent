diff --git a/home/user/NgotakStreamQx/src/lib/player/openPlayer.ts b/src/lib/player/openPlayer.ts
new file mode 100644
index 0000000..8e72395
--- /dev/null
+++ b/src/lib/player/openPlayer.ts
@@ -0,0 +1,24 @@
+import Orientation from 'react-native-orientation-locker';
+
+type NavigateToPlayer = {
+  navigate: (...args: any[]) => unknown;
+};
+
+/**
+ * Membuka layar Player dengan rotasi landscape yang dipicu PADA SAAT TAP —
+ * dari layar sumber yang sedang idle — sebelum layar Player di-mount.
+ *
+ * `setRequestedOrientation` dieksekusi seketika di momen tap dan tidak ikut
+ * mengantri di belakang pekerjaan JS apa pun yang terjadi saat mount Player
+ * (sync folder bersama, statistik, resolusi stream, dsb.). Layar Player
+ * mempertahankan lock melalui <OrientationLocker LANDSCAPE> pada tiap branch
+ * render dan memulihkan portrait saat keluar via exitFullScreen()
+ * (topologi base v1.0.3-fixed tetap utuh).
+ */
+export const openPlayer = (
+  navigation: NavigateToPlayer,
+  params: Record<string, unknown>,
+): void => {
+  Orientation.lockToLandscape();
+  navigation.navigate('Player', params);
+};
